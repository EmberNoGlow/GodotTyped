[sub_resource type="GDScript" id="GDScript_mf4mk"]
script/source = "extends Node

func sum(a: float, b: float) -> float:
	var result = a+b
	print(a, \" + \", b, \" = \", result)
	return result


func distance(a: Vector2, b: Vector2) -> float:
	var result = a.distance_to(b)
	print(\"the distance from \", a, \" to \", b, \" is \", result)
	return result


func _ready() -> void:
	print(\"HELLO FROM GDT\")
	sum(
		2.2,
		round(
			distance(
				Vector2(0, 4),
				Vector2(-2, 6)
				)
			)
		)


"

